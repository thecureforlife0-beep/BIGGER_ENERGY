# -----------------------------------------------------------------------------
# Environment template. Copy to .env.local and fill in real values.
# NEVER commit real secrets. Only this .env.example is tracked by git.
# -----------------------------------------------------------------------------

# --- Needed now: Redis (Upstash or Vercel KV) --------------------------------
# The app also accepts UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Needed now: site URL ----------------------------------------------------
# Dev example: http://localhost:3000 ; Prod: your HTTPS domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Needed now: legacy fulfillment endpoint + email -------------------------
EGGPLANT_METHOD_INTERNAL_SECRET_KEY=
EGGPLANT_METHOD_GMAIL_USER=
EGGPLANT_METHOD_GMAIL_APP_PASSWORD=

# --- Later: blunt.cash crypto checkout (NOT yet implemented) -----------------
BLUNT_PUBLIC_API_KEY=
BLUNT_SECRET_API_KEY=
BLUNT_MERCHANT_ID=
BLUNT_WEBHOOK_SECRET=
BLUNT_MODE=test
BLUNT_ACCEPTED_CHAINS=
BLUNT_EXPECTED_DESTINATION_WALLETS_JSON=

# --- Later: Mux private video (NOT yet implemented) --------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
MUX_ENVIRONMENT=

# --- Later: private media master archive (provider-specific) -----------------
MEDIA_MASTER_BUCKET=
MEDIA_MASTER_ENDPOINT=
MEDIA_MASTER_ACCESS_KEY_ID=
MEDIA_MASTER_SECRET_ACCESS_KEY=
