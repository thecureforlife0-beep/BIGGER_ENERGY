# -----------------------------------------------------------------------------
# Environment Template for BIGGER_ENERGY Storefront
# Copy to .env.local and fill in your real values.
# NEVER commit real secret keys. Only this .env.example is tracked by git.
# -----------------------------------------------------------------------------

# --- 1. Production Domain & Site URL -----------------------------------------
# Localhost in dev, your Vercel domain in production (e.g. https://bigger-energy.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- 2. Payment Provider Rail Configuration ----------------------------------
# Options: 'blunt' | 'provider_b' | 'both'
NEXT_PUBLIC_ACTIVE_PAYMENT_PROVIDER=blunt

# --- 3. Blunt.cash Crypto Settlement Engine (Primary Provider) ---------------
# Merchant ID supplied by your Blunt.cash dashboard:
BLUNT_MERCHANT_ID=ed70a7cd-999a-46ac-8b3e-3c48c1cdafe6
# Public Key for embedding checkout widget in the bottom sheet:
NEXT_PUBLIC_BLUNT_PUBLIC_KEY=
# Webhook secret to verify HMAC-SHA256 signature from Blunt:
BLUNT_WEBHOOK_SECRET=
# Operating mode: 'live' or 'test'
BLUNT_MODE=test
# Supported chains (comma-separated):
BLUNT_ACCEPTED_CHAINS=base,sol
# Destination wallets JSON (matches chains to your receiving addresses):
BLUNT_EXPECTED_DESTINATION_WALLETS_JSON={"sol":"","base":""}

# --- 4. Secondary Payment Provider (Paymegate / Provider B Rail) -------------
# Name and badge displayed on checkout sheet when enabled:
SECONDARY_PAYMENT_PROVIDER=paymegate
PAYMEGATE_API_KEY=
PAYMEGATE_CHECKOUT_URL=https://www.paymegate.com/checkout/884a31cd-6589-449e-90a8-da36aa5469ef
PAYMEGATE_WEBHOOK_SECRET=
NEXT_PUBLIC_PROVIDER_B_NAME="Paymegate"
NEXT_PUBLIC_PROVIDER_B_BADGE="Direct Crypto · Cards · Global Rail"
NEXT_PUBLIC_PROVIDER_B_CHAINS="Solana · BTC · EVM · TRC20"
NEXT_PUBLIC_PROVIDER_B_PAYMENT_URL=https://www.paymegate.com/checkout/884a31cd-6589-449e-90a8-da36aa5469ef

# --- 5. Redis Store (Upstash or Vercel KV) -----------------------------------
# Used for atomic order state, SHA-256 entitlements, and token lookups.
# (Dev mode falls back to local in-memory storage if these are unset).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 6. Mux Private Signed Video Streaming (Primary Account / Environment) ---
# Playback ID of your uploaded video (set policy to 'Signed' in Mux):
MUX_PLAYBACK_ID=
# Signing Key ID from Mux Dashboard -> Settings -> Signing Keys:
MUX_SIGNING_KEY_ID=
# Private Key (base64 string or full PEM block) from Mux Signing Keys modal:
MUX_PRIVATE_KEY=

# --- 7. Mux Secondary Account / Environment (Optional Fallback) --------------
# Active Mux environment: 'primary' | 'secondary' (default: primary)
MUX_ACTIVE_ENV=primary
MUX_SECONDARY_PLAYBACK_ID=
MUX_SECONDARY_SIGNING_KEY_ID=
MUX_SECONDARY_PRIVATE_KEY=

# --- 8. Customer Email Link Delivery (Zero-Domain OR Custom Domain) ----------
# OPTION A (RECOMMENDED FREE - NO CUSTOM DOMAIN NEEDED, 500/day): Gmail SMTP
# Create an App Password at https://myaccount.google.com/apppasswords
EMAIL_FROM_NAME="Bigger Energy"
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OPTION B (FREE - NO CUSTOM DOMAIN NEEDED, 300/day): Brevo REST API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# OPTION C (Generic SMTP - Brevo SMTP, Zoho, Outlook, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# OPTION D (Resend — requires your own verified .com/.xyz domain for real buyers)
# NOTE: onboarding@resend.dev ONLY delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy endpoint internal authorization (optional):
EGGPLANT_METHOD_INTERNAL_SECRET_KEY=
