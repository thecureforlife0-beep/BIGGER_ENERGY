# -----------------------------------------------------------------------------
# Environment Template for Chad Kermit Storefront
# Copy to .env.local and fill in your real values.
# NEVER commit real secret keys. Only this .env.example is tracked by git.
# -----------------------------------------------------------------------------

# --- 1. Production Domain & Site URL -----------------------------------------
# Localhost in dev, your Vercel domain in production (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- 2. Redis Store (Upstash or Vercel KV) -----------------------------------
# Used for atomic order state, SHA-256 entitlements, and token lookups.
# (Dev mode falls back to local in-memory storage if these are unset).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 3. Blunt.cash Crypto Settlement Engine -----------------------------------
# Merchant ID supplied by your Blunt.cash dashboard:
BLUNT_MERCHANT_ID=ed70a7cd-999a-46ac-8b3e-3c48c1cdafe6
# Public Key for embedding checkout widget in the bottom sheet:
NEXT_PUBLIC_BLUNT_PUBLIC_KEY=
# Webhook secret to verify HMAC-SHA256 signature from Blunt:
BLUNT_WEBHOOK_SECRET=
# Operating mode: 'live' or 'test'
BLUNT_MODE=test
# Supported chains (comma-separated):
BLUNT_ACCEPTED_CHAINS=base,sol
# Destination wallets JSON (matches chains to your receiving addresses):
BLUNT_EXPECTED_DESTINATION_WALLETS_JSON={"sol":"","base":""}

# --- 4. Mux Private Signed Video Streaming ------------------------------------
# Playback ID of your uploaded video (set policy to 'Signed' in Mux):
MUX_PLAYBACK_ID=
# Signing Key ID from Mux Dashboard -> Settings -> Signing Keys:
MUX_SIGNING_KEY_ID=
# Private Key (base64 string or full PEM block) from Mux Signing Keys modal:
MUX_PRIVATE_KEY=

# --- 5. Customer Email Link Delivery (Resend) ---------------------------------
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. On free plan use: onboarding@resend.dev
# After verifying your domain in Resend, use: hello@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy endpoint internal authorization (optional):
EGGPLANT_METHOD_INTERNAL_SECRET_KEY=
